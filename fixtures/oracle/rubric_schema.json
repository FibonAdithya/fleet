{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet.rubric.v1",
  "type": "object",
  "required": ["key", "proves", "terminal_state", "assertions"],
  "additionalProperties": false,
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "proves": { "type": "string", "minLength": 1 },
    "terminal_state": {
      "description": "The state a correct run ends in. A list where the issue authorises more than one branch -- issue 06 spells out both a fix and an escalation, and grading either as a failure penalises the agent for doing what it was told.",
      "oneOf": [
        { "$ref": "#/$defs/state" },
        {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/state" }
        }
      ]
    },
    "hard_fail": { "type": "boolean" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["paths_touched", "paths_untouched", "command", "label", "comment_contains", "issue_created", "manual"] },
          "detail": { "type": "string", "minLength": 1 },
          "expect": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "state": { "enum": ["done", "human", "blocked", "triage"] }
  }
}
